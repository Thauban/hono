{
  "name": "soldat",
  "version": "2026.4.1",
  "private": true,
  "description": "Beispiel",
  "keywords": [
    "Bun",
    "Prisma",
    "PostgreSQL",
    "TypeScript",
    "ESLint",
    "Prettier"
  ],
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "build": "bun build --compile --sourcemap ./src/beispiele.mts",
    "build:write": "bun build --compile --sourcemap ./src/beispiele-write.mts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prettier": "prettier -w src/*.mts"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "hono": "4.12.14",
    "lodash": "4.17.23"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "@prisma/sqlcommenter-query-insights": "7.7.0",
    "dotenv": "17.4.2",
    "figlet": "1.11.0",
    "hono": "4.12.14",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "pg": "8.20.0",
    "smol-toml": "1.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hono/node-server": "1.19.14",
    "@prettier/plugin-oxc": "0.1.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/node24": "24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.3.12",
    "@types/eslint-plugin-security": "3.0.1",
    "@types/pg": "8.20.0",
    "@vitest/eslint-plugin": "1.6.16",
    "oxfmt": "0.49.0",
    "oxlint": "1.64.0",
    "oxlint-tsgolint": "0.22.1",
    "globals": "17.5.0",
    "jiti": "2.6.1",
    "leasot": "14.4.0",
    "prettier": "3.8.3",
    "prisma": "7.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.2"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.3.13",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "version": "1.3.13",
      "onFail": "error"
    }
  },
  "module": "index.ts"
}
